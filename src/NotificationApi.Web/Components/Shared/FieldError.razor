@* The messages for one form field, next to that field. *@
@if (Errors is not null && Errors.TryGetValue(Field, out var messages) && messages.Length > 0)
{
  <div class="field-error" id="error-@Field" data-testid="error-@Field">
    @foreach (var message in messages)
    {
      <div>@message</div>
    }
  </div>
}

@code {
  [Parameter] public IReadOnlyDictionary<string, string[]>? Errors { get; set; }

  [Parameter, EditorRequired] public string Field { get; set; } = string.Empty;

  /// <summary>The <c>aria-invalid</c> value for an input: "true" when the field has errors, otherwise no attribute.</summary>
  public static string? Invalid(IReadOnlyDictionary<string, string[]>? errors, string field) =>
    errors is not null && errors.TryGetValue(field, out var messages) && messages.Length > 0 ? "true" : null;
}
