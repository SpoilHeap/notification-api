@page "/audit"
@using System.Globalization
@using NotificationApi.Application.Audit
@inject GetAuditLog GetAuditLog

<PageTitle>Audit log · Notification API</PageTitle>

<header class="page-header">
  <h1>Audit log</h1>
  <p class="lead">Every change made in this web UI, newest first, with the Home Assistant user who made it. Phone numbers are masked.</p>
</header>

<section class="card flush">
  @if (_page.Total == 0)
  {
    <p class="empty" data-testid="empty">Nothing has been recorded yet.</p>
  }
  else
  {
    <div class="table-wrap">
      <table class="list audit reflow" data-testid="audit">
        <thead><tr><th scope="col">When (UTC)</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">What</th><th scope="col">Details</th></tr></thead>
        <tbody>
          @foreach (var entry in _page.Entries)
          {
            <tr>
              <td class="nowrap">@entry.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
              <td title="HA user id @entry.HaUserId">@entry.HaUserDisplayName</td>
              <td><span class="chip">@entry.Action</span></td>
              <td class="what">@entry.EntityType <code>@entry.EntityKey</code></td>
              <td class="summary">@entry.Summary</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
    <nav class="pager" aria-label="Pages">
      <span class="pager-link">
        @if (_page.Page > 1)
        {
          <a href="audit?page=@(_page.Page - 1)" data-testid="newer">← Newer</a>
        }
      </span>
      <span class="pager-status">Page @_page.Page of @_page.PageCount (@_page.Total entries)</span>
      <span class="pager-link next">
        @if (_page.Page < _page.PageCount)
        {
          <a href="audit?page=@(_page.Page + 1)" data-testid="older">Older →</a>
        }
      </span>
    </nav>
  }
</section>

@code {
  private AuditLogPage _page = new([], 1, 1, 0);

  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

  protected override async Task OnInitializedAsync() =>
    _page = await GetAuditLog.HandleAsync(PageNumber ?? 1, HttpContext.RequestAborted);
}
