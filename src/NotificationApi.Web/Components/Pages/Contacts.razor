@page "/contacts"
@using NotificationApi.Application.Common
@using NotificationApi.Application.Contacts
@using NotificationApi.Application.Recipients
@inject ListContacts ListContacts
@inject CreateContact CreateContact

<PageTitle>Contacts · Notification API</PageTitle>

<header class="page-header">
  <h1>Contacts</h1>
</header>

@if (Deleted is not null)
{
  <p class="notice success" role="status" data-testid="flash">Deleted contact:@Deleted.</p>
}

<section class="card flush">
  @if (_contacts.Count == 0)
  {
    <p class="empty" data-testid="empty">No contacts yet. Create one below.</p>
  }
  else
  {
    <div class="table-wrap">
      <table class="list reflow" data-testid="contacts">
        <thead><tr><th scope="col">Handle</th><th scope="col">Name</th><th scope="col">Endpoints</th></tr></thead>
        <tbody>
          @foreach (var contact in _contacts)
          {
            <tr>
              <td><a href="contacts/@contact.HandleName"><code>@contact.Handle</code></a></td>
              <td>@contact.Name</td>
              <td>
                @if (contact.Endpoints.Count == 0)
                {
                  <span class="hint">None</span>
                }
                else
                {
                  <span class="endpoints">
                    @foreach (var endpoint in contact.Endpoints)
                    {
                      <span class="chip">@ChannelNames.Of(endpoint.Channel) @endpoint.MaskedAddress</span>
                    }
                  </span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

<section class="card">
  <h2>New contact</h2>
  <form method="post" @formname="create-contact" @onsubmit="CreateAsync" class="stack">
    <AntiforgeryToken />
    <div class="field">
      <label for="new-handle">Handle</label>
      <div class="input-prefix"><span class="prefix">contact:</span><input id="new-handle" name="NewContact.Handle" value="@NewContact?.Handle" maxlength="64" autocomplete="off" aria-describedby="handle-hint error-@RecipientFields.Handle" aria-invalid="@FieldError.Invalid(_errors, RecipientFields.Handle)" /></div>
      <p class="hint" id="handle-hint">Lower-case letters, digits and underscores. Home Assistant automations use it, so it can't be changed later.</p>
      <FieldError Errors="_errors" Field="@RecipientFields.Handle" />
    </div>
    <div class="field">
      <label for="new-name">Name</label>
      <input id="new-name" name="NewContact.Name" value="@NewContact?.Name" maxlength="100" aria-describedby="error-@RecipientFields.Name" aria-invalid="@FieldError.Invalid(_errors, RecipientFields.Name)" />
      <FieldError Errors="_errors" Field="@RecipientFields.Name" />
    </div>
    <div class="form-actions"><button type="submit">Create contact</button></div>
  </form>
</section>

@code {
  private IReadOnlyList<ContactSummary> _contacts = [];
  private IReadOnlyDictionary<string, string[]>? _errors;

  [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "create-contact")] private CreateForm? NewContact { get; set; }

  [SupplyParameterFromQuery] public string? Deleted { get; set; }

  protected override async Task OnInitializedAsync()
  {
    NewContact ??= new();
    _contacts = await ListContacts.HandleAsync(HttpContext.RequestAborted);
  }

  private async Task CreateAsync()
  {
    var result = await CreateContact.HandleAsync(
      HttpContext.User.ToAuditActor(), new CreateRecipientCommand(NewContact?.Handle, NewContact?.Name), HttpContext.RequestAborted);
    if (result.IsSuccess)
    {
      PostRedirectGet.SeeOther(HttpContext, $"contacts/{result.Value.Name}?saved=created");
      return;
    }

    _errors = result.Error.FieldErrors;
  }

  public sealed class CreateForm
  {
    public string? Handle { get; set; }

    public string? Name { get; set; }
  }
}
