{
  "openapi": "3.1.1",
  "info": {
    "title": "Notification API",
    "description": "Used by the Home Assistant integration. Authenticate with Authorization: Bearer <api token>.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ping": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Checks the API token. The HA integration calls this during setup.",
        "operationId": "Ping",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PingResponse": {
        "required": [
          "ok",
          "version"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Always true: a valid token reached the API."
          },
          "version": {
            "type": "string",
            "description": "The add-on version, matching `config.yaml` in released images."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "v1"
    }
  ]
}
