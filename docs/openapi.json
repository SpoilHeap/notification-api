{
  "openapi": "3.1.1",
  "info": {
    "title": "Notification API",
    "description": "Used by the Home Assistant integration. Authenticate with Authorization: Bearer <api token>.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ping": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Checks the API token and identifies the installation. The HA integration calls this during setup.",
        "operationId": "Ping",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notify": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Queues a notification for the given handles and answers 202 at once; delivery happens in the background. 400 for an invalid payload or unknown handle, 422 when nothing would be delivered.",
        "operationId": "Notify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipients": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Every contact and group, with no PII. Send If-None-Match with the last ETag to get 304 when nothing changed.",
        "operationId": "GetRecipients",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipientsResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/v1/webhook": {
      "put": {
        "tags": [
          "v1"
        ],
        "summary": "Registers the webhook that events are POSTed to, replacing any earlier one.",
        "operationId": "RegisterWebhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterWebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "The registered webhook URL (never the secret). 404 when none is registered.",
        "operationId": "GetWebhook",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "v1"
        ],
        "summary": "Removes the webhook, which stops events. Succeeds when none is registered.",
        "operationId": "RemoveWebhook",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "NotifyDeliveryResponse": {
        "required": [
          "delivery_id",
          "contact",
          "via",
          "channel",
          "status"
        ],
        "type": "object",
        "properties": {
          "delivery_id": {
            "type": "string",
            "description": "`dlv_` plus 32 lower-case hex digits."
          },
          "contact": {
            "type": "string",
            "description": "The contact's handle name, without `contact:`, e.g. `alice`."
          },
          "via": {
            "type": "string",
            "description": "The handle from `to` that reached the contact."
          },
          "channel": {
            "type": "string",
            "description": "`telegram` or `sms`."
          },
          "status": {
            "type": "string",
            "description": "Always `queued` here; later states arrive as events."
          }
        }
      },
      "NotifyRequest": {
        "required": [
          "to",
          "message",
          "priority"
        ],
        "type": "object",
        "properties": {
          "to": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Recipient handles, e.g. `contact:alice`, `group:family`. Required, non-empty."
          },
          "message": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required, 1-4000 characters."
          },
          "priority": {
            "type": [
              "null",
              "string"
            ],
            "description": "Required: low, normal, high or critical (lower case)."
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 200 characters."
          },
          "channels": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Optional override: telegram and/or sms. Omitted, null or [] means each contact's routing decides."
          },
          "tag": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 200 characters. Logged and passed back in delivery events."
          },
          "actions": {
            "description": "Reserved for v2. Omitted, null or [] only."
          },
          "source": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 200 characters, e.g. the automation's entity id."
          },
          "idempotency_key": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional, at most 200 characters. The same key within 24 h returns the first answer and sends nothing new."
          }
        }
      },
      "NotifyResponse": {
        "required": [
          "notification_id",
          "deliveries"
        ],
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "description": "`ntf_` plus 32 lower-case hex digits."
          },
          "deliveries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotifyDeliveryResponse"
            },
            "description": "One per (contact, via, channel), in request order, depth-first, then channel order."
          }
        }
      },
      "PingResponse": {
        "required": [
          "ok",
          "version",
          "instance_id"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Always true: a valid token reached the API."
          },
          "version": {
            "type": "string",
            "description": "The add-on version, matching `config.yaml` in released images."
          },
          "instance_id": {
            "type": "string",
            "description": "A lower-case UUID created with the database and never changed (spec §4.2, AC44)."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecipientResponse": {
        "required": [
          "handle",
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "description": "E.g. `group:family`. Never changes."
          },
          "name": {
            "type": "string",
            "description": "The display name."
          },
          "type": {
            "type": "string",
            "description": "`contact` or `group`."
          }
        }
      },
      "RecipientsResponse": {
        "required": [
          "revision",
          "recipients"
        ],
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "description": "Opaque. Changes whenever a contact or group is created, renamed or deleted. Also sent as the ETag."
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipientResponse"
            },
            "description": "Every contact and group."
          }
        }
      },
      "RegisterWebhookRequest": {
        "required": [
          "url",
          "secret"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute http(s) URL that events are POSTed to."
          },
          "secret": {
            "type": [
              "null",
              "string"
            ],
            "description": "Standard base64 of at least 32 random bytes. The HMAC key is the decoded bytes."
          }
        }
      },
      "WebhookResponse": {
        "required": [
          "url",
          "registered_at"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The registered URL."
          },
          "registered_at": {
            "type": "string",
            "description": "When it was registered (UTC).",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "v1"
    }
  ]
}
